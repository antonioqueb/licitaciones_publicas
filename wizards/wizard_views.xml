<odoo>
<record id="view_carga_wizard" model="ir.ui.view"><field name="name">view_carga_wizard</field><field name="model">licitacion.carga.wizard</field><field name="arch" type="xml"><form string="Previsualizar cambios"><group><field name="archivo_nombre" invisible="1"/><field name="archivo" filename="archivo_nombre"/><field name="fecha_snapshot" /><field name="tipo_detectado" /><field name="origen_portal" /><field name="alcance" /><field name="zona_horaria" /></group><p>Declare la fecha de descarga. Ningún procedimiento o partida cambia antes de confirmar el preview.</p><footer><button name="action_preview" string="Previsualizar cambios" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="action_carga_wizard" model="ir.actions.act_window"><field name="name">Nueva carga</field><field name="res_model">licitacion.carga.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
<record id="view_asignar_procedimiento_wizard" model="ir.ui.view"><field name="name">view_asignar_procedimiento_wizard</field><field name="model">licitacion.asignar.procedimiento.wizard</field><field name="arch" type="xml"><form string="Asignar y previsualizar"><group><field name="carga_id" /><field name="procedimiento_id" /><field name="nota" /></group><footer><button name="action_asignar" string="Asignar y previsualizar" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_preview" model="ir.ui.view"><field name="name">view_preview</field><field name="model">licitacion.preview.wizard</field><field name="arch" type="xml"><form string="Previsualización"><group><field name="carga_id" /><field name="resumen" /></group><div class="alert alert-warning" invisible="not advertencias"><field name="advertencias" /></div><notebook><page string="Nuevos"><field name="nuevos_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page><page string="Cambios"><field name="cambios_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page><page string="Sin cambios"><field name="sin_cambios_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page><page string="Ya no aparecen"><field name="gone_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page></notebook><footer><button name="action_confirm" string="Confirmar importación" type="object" class="btn-primary"/><button name="action_rechazar" string="Rechazar carga" type="object" /><button string="Cerrar" special="cancel"/></footer></form></field></record>
<record id="view_criba_wizard" model="ir.ui.view"><field name="name">view_criba_wizard</field><field name="model">licitacion.criba.wizard</field><field name="arch" type="xml"><form string="Aplicar decisión"><group><field name="procedimiento_ids" widget="many2many_tags"/><field name="es_lote" /><field name="decision" /><field name="motivo_id" invisible="decision not in ('descartar','no_viable')" required="decision in ('descartar','no_viable')"/><field name="nota" /></group><footer><button name="action_apply" string="Aplicar decisión" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_generar_expedientes_wizard" model="ir.ui.view"><field name="name">view_generar_expedientes_wizard</field><field name="model">licitacion.generar.expedientes.wizard</field><field name="arch" type="xml"><form string="Generar expedientes"><group><field name="procedimiento_id" /><field name="resumen" /></group><p>Un expediente por empresa y una carta por proveedor. Se conservarán los existentes.</p><footer><button name="action_generate" string="Generar expedientes" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_resolver_incidencia_wizard" model="ir.ui.view"><field name="name">view_resolver_incidencia_wizard</field><field name="model">licitacion.resolver.incidencia.wizard</field><field name="arch" type="xml"><form string="Aplicar resolución"><group><field name="incidencia_id" /><field name="decision" /><field name="nota" /></group><footer><button name="action_apply" string="Aplicar resolución" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_propagar_empresas_wizard" model="ir.ui.view"><field name="name">view_propagar_empresas_wizard</field><field name="model">licitacion.propagar.empresas.wizard</field><field name="arch" type="xml"><form string="Propagar empresas"><group><field name="partida_ids" widget="many2many_tags"/><field name="fuente_id" domain="[('id','in',partida_ids)]"/></group><p>La selección fuente reemplazará las asignaciones de las otras partidas.</p><footer><button name="action_apply" string="Propagar empresas" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_propagar_proveedores_wizard" model="ir.ui.view"><field name="name">view_propagar_proveedores_wizard</field><field name="model">licitacion.propagar.proveedores.wizard</field><field name="arch" type="xml"><form string="Propagar proveedores"><group><field name="partida_ids" widget="many2many_tags"/><field name="fuente_id" domain="[('id','in',partida_ids)]"/></group><p>La selección fuente reemplazará las asignaciones de las otras partidas.</p><footer><button name="action_apply" string="Propagar proveedores" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>

</odoo>