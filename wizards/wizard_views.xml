<odoo>
<record id="view_carga_wizard" model="ir.ui.view"><field name="name">view_carga_wizard</field><field name="model">licitacion.carga.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Nueva carga"><field name="detalle_borrador" invisible="1"/><div class="alert alert-warning" role="alert" invisible="not detalle_borrador">BORRADOR - Pendiente validación cliente. Revise las cantidades y las incidencias SAI antes de continuar.</div><group><field name="archivo_nombre" invisible="1"/><field name="archivo" filename="archivo_nombre"/><field name="fecha_snapshot" /><field name="tipo_detectado" /><field name="origen_portal" /><field name="alcance" /><field name="zona_horaria" /></group>
<div class="alert alert-warning" role="alert" invisible="not cargas_previas_ids">
<strong>El archivo «<field name="archivo_nombre" readonly="1" nolabel="1"/>» ya fue procesado.</strong>
<p>Consulte la carga anterior. Para procesarlo nuevamente debe indicar un motivo y confirmar la reimportación.</p>
<group><field name="carga_previa_id" domain="[('id','in',cargas_previas_ids)]" options="{'no_create': True, 'no_create_edit': True}"/>
<field name="previa_snapshot"/><field name="previa_procesada"/><field name="previa_usuario_id"/><field name="previa_resumen"/><field name="previa_state"/></group>
<field name="cargas_previas_ids" readonly="1" nolabel="1"><list create="0" edit="0" delete="0">
<field name="archivo_nombre"/><field name="fecha_snapshot"/><field name="procesado_el"/><field name="procesado_por_id"/>
<field name="resumen"/><field name="state"/><button name="action_open" string="Abrir" type="object"/>
</list></field></div><p>Declare la fecha de descarga. Ningún procedimiento o partida cambia antes de confirmar la previsualización.</p>
<footer><button name="action_preview" string="Previsualizar cambios" type="object" class="btn-primary" invisible="cargas_previas_ids"/>
<span class="btn btn-primary disabled" role="button" aria-disabled="true" invisible="not cargas_previas_ids">Previsualizar cambios</span>
<button name="action_open_existing" string="Abrir carga existente" type="object" invisible="not cargas_previas_ids"/>
<button string="Cancelar" special="cancel"/>
<button name="action_force" string="Forzar re-importación (avanzado)" type="object" invisible="not cargas_previas_ids"/>
</footer></form></field></record>
<record id="action_carga_wizard" model="ir.actions.act_window"><field name="name">Nueva carga</field><field name="res_model">licitacion.carga.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
<record id="view_forzar_carga_wizard" model="ir.ui.view"><field name="name">view_forzar_carga_wizard</field><field name="model">licitacion.forzar.carga.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Confirmar reimportación"><p>Se creará una nueva carga del mismo archivo. Las anteriores se conservarán.</p><group><field name="carga_wizard_id" /><field name="motivo" /><field name="confirmado" required="1"/></group><footer><button name="action_confirm" string="Confirmar reimportación" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_asignar_procedimiento_wizard" model="ir.ui.view"><field name="name">view_asignar_procedimiento_wizard</field><field name="model">licitacion.asignar.procedimiento.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Asignar y previsualizar"><group><field name="carga_id" /><field name="procedimiento_id" /><field name="nota" /></group><footer><button name="action_asignar" string="Asignar y previsualizar" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_preview" model="ir.ui.view"><field name="name">view_preview</field><field name="model">licitacion.preview.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Previsualización"><field name="detalle_borrador" invisible="1"/><div class="alert alert-warning" role="alert" invisible="not detalle_borrador">BORRADOR - Pendiente validación cliente. Revise las cantidades y las incidencias SAI antes de continuar.</div><group><field name="carga_id" /><field name="resumen" /><field name="carga_base_id" /></group><div class="alert alert-info" role="status" invisible="not aviso_base"><field name="aviso_base" nolabel="1"/></div><div class="alert alert-warning" role="alert" invisible="not advertencias"><field name="advertencias" /></div><notebook><page string="Nuevos"><field name="nuevos_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page><page string="Cambios"><field name="cambios_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page><page string="Sin cambios"><field name="sin_cambios_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page><page string="Ya no aparecen"><field name="gone_ids"><list create="0" edit="0" delete="0"><field name="clave" /><field name="descripcion" /><field name="detalle" /></list><form><group><field name="clave" /><field name="descripcion" /><field name="detalle" /></group></form></field></page></notebook><footer><button name="action_confirm" string="Confirmar importación" type="object" class="btn-primary"/><button name="action_rechazar" string="Rechazar carga" type="object" /><button string="Cerrar" special="cancel"/></footer></form></field></record>
<record id="view_criba_wizard" model="ir.ui.view"><field name="name">view_criba_wizard</field><field name="model">licitacion.criba.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Aplicar decisión"><group><field name="procedimiento_ids" widget="many2many_tags"/><field name="es_lote" /><field name="decision" /><field name="motivo_id" invisible="decision not in ('descartar','no_viable')" required="decision in ('descartar','no_viable')"/><field name="nota" /></group><footer><button name="action_apply" string="Aplicar decisión" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_generar_expedientes_wizard" model="ir.ui.view"><field name="name">view_generar_expedientes_wizard</field><field name="model">licitacion.generar.expedientes.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Generar expedientes"><group><field name="procedimiento_id" /><field name="resumen" /></group><p>Un expediente por empresa y una carta por proveedor. Se conservarán los existentes.</p><footer><button name="action_generate" string="Generar expedientes" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_resolver_incidencia_wizard" model="ir.ui.view"><field name="name">view_resolver_incidencia_wizard</field><field name="model">licitacion.resolver.incidencia.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Aplicar resolución"><group><field name="incidencia_id" /><field name="decision" /><field name="es_catalogo" invisible="1"/><field name="campo" invisible="1"/><field name="valor_encontrado" invisible="not es_catalogo"/><field name="entidad_federativa_id" invisible="not (es_catalogo and decision == 'resolver' and campo == 'entidad_federativa')" required="es_catalogo and decision == 'resolver' and campo == 'entidad_federativa'" options="{'no_create': True}"/><field name="estatus_portal_id" invisible="not (es_catalogo and decision == 'resolver' and campo == 'estatus_portal')" required="es_catalogo and decision == 'resolver' and campo == 'estatus_portal'" options="{'no_create': True}"/><field name="tipo_contratacion_id" invisible="not (es_catalogo and decision == 'resolver' and campo == 'tipo_contratacion')" required="es_catalogo and decision == 'resolver' and campo == 'tipo_contratacion'" options="{'no_create': True}"/><field name="tipo_procedimiento_id" invisible="not (es_catalogo and decision == 'resolver' and campo == 'tipo_procedimiento')" required="es_catalogo and decision == 'resolver' and campo == 'tipo_procedimiento'" options="{'no_create': True}"/><field name="caracter_procedimiento_id" invisible="not (es_catalogo and decision == 'resolver' and campo == 'caracter_procedimiento')" required="es_catalogo and decision == 'resolver' and campo == 'caracter_procedimiento'" options="{'no_create': True}"/><field name="unidad_compradora_id" invisible="not (es_catalogo and decision == 'resolver' and campo == 'unidad_compradora')" required="es_catalogo and decision == 'resolver' and campo == 'unidad_compradora'" options="{'no_create': True}"/><field name="guardar_alias" invisible="not es_catalogo or decision != 'resolver' or campo != 'entidad_federativa'"/><div class="alert alert-info" invisible="not es_catalogo or decision != 'resolver' or campo == 'entidad_federativa'">Revise el catálogo y sus nombres alternativos, si los admite. Esta corrección asigna el registro seleccionado sin agregar alias automáticamente.</div><field name="nota" /></group><footer><button name="action_apply" string="Aplicar resolución" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_propagar_empresas_wizard" model="ir.ui.view"><field name="name">view_propagar_empresas_wizard</field><field name="model">licitacion.propagar.empresas.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Propagar empresas"><group><field name="partida_ids" widget="many2many_tags"/><field name="fuente_id" domain="[('id','in',partida_ids)]"/></group><p>La selección fuente reemplazará las asignaciones de las otras partidas.</p><footer><button name="action_apply" string="Propagar empresas" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>
<record id="view_propagar_proveedores_wizard" model="ir.ui.view"><field name="name">view_propagar_proveedores_wizard</field><field name="model">licitacion.propagar.proveedores.wizard</field><field name="arch" type="xml"><form class="o_lp_view o_lp_wizard" string="Propagar proveedores"><group><field name="partida_ids" widget="many2many_tags"/><field name="fuente_id" domain="[('id','in',partida_ids)]"/></group><p>La selección fuente reemplazará las asignaciones de las otras partidas.</p><footer><button name="action_apply" string="Propagar proveedores" type="object" class="btn-primary"/><button string="Cancelar" special="cancel"/></footer></form></field></record>

</odoo>