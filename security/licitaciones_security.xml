<odoo>
<record id="module_category_licitaciones" model="ir.module.category"><field name="name">Licitaciones Públicas</field></record>
<record id="privilege_licitaciones" model="res.groups.privilege"><field name="name">Licitaciones Públicas</field><field name="category_id" ref="module_category_licitaciones"/></record>
<record id="group_licitaciones_user" model="res.groups"><field name="name">Usuario de Licitaciones</field><field name="privilege_id" ref="privilege_licitaciones"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
<record id="group_licitaciones_manager" model="res.groups"><field name="name">Administrador de Licitaciones</field><field name="privilege_id" ref="privilege_licitaciones"/><field name="implied_ids" eval="[(4, ref('group_licitaciones_user'))]"/><field name="user_ids" eval="[(4, ref('base.user_admin'))]"/></record>
<record id="rule_procedimiento" model="ir.rule"><field name="name">procedimiento: empresas activas</field><field name="model_id" ref="model_licitacion_procedimiento"/><field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field></record>
<record id="rule_partida" model="ir.rule"><field name="name">partida: empresas activas</field><field name="model_id" ref="model_licitacion_partida"/><field name="domain_force">['|', ('procedimiento_id.company_ids', '=', False), ('procedimiento_id.company_ids', 'in', company_ids)]</field></record>
<record id="rule_partida_empresa" model="ir.rule"><field name="name">partida.empresa: empresas activas</field><field name="model_id" ref="model_licitacion_partida_empresa"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_partida_proveedor" model="ir.rule"><field name="name">partida.proveedor: empresas activas</field><field name="model_id" ref="model_licitacion_partida_proveedor"/><field name="domain_force">['|', ('partida_id.procedimiento_id.company_ids', '=', False), ('partida_id.procedimiento_id.company_ids', 'in', company_ids)]</field></record>
<record id="rule_expediente" model="ir.rule"><field name="name">expediente: empresas activas</field><field name="model_id" ref="model_licitacion_expediente"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_pregunta" model="ir.rule"><field name="name">pregunta: empresas activas</field><field name="model_id" ref="model_licitacion_pregunta"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_costeo_linea" model="ir.rule"><field name="name">costeo.linea: empresas activas</field><field name="model_id" ref="model_licitacion_costeo_linea"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_documento" model="ir.rule"><field name="name">documento: empresas activas</field><field name="model_id" ref="model_licitacion_documento"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_documento_version" model="ir.rule"><field name="name">documento.version: empresas activas</field><field name="model_id" ref="model_licitacion_documento_version"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_carta_apoyo" model="ir.rule"><field name="name">carta.apoyo: empresas activas</field><field name="model_id" ref="model_licitacion_carta_apoyo"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_carga" model="ir.rule"><field name="name">carga: empresas activas</field><field name="model_id" ref="model_licitacion_carga"/><field name="domain_force">[('company_ids', 'in', company_ids)]</field></record>
<record id="rule_aparicion" model="ir.rule"><field name="name">aparicion: empresas activas</field><field name="model_id" ref="model_licitacion_aparicion"/><field name="domain_force">['|', ('procedimiento_id.company_ids', '=', False), ('procedimiento_id.company_ids', 'in', company_ids)]</field></record>
<record id="rule_incidencia" model="ir.rule"><field name="name">incidencia: empresas activas</field><field name="model_id" ref="model_licitacion_incidencia"/><field name="domain_force">['&amp;', '|', ('carga_id', '=', False), ('carga_id.company_ids', 'in', company_ids), '|', '&amp;', ('procedimiento_id', '!=', False), '|', ('procedimiento_id.company_ids', '=', False), ('procedimiento_id.company_ids', 'in', company_ids), '&amp;', ('procedimiento_id', '=', False), ('carga_id.company_ids', 'in', company_ids)]</field></record>
<record id="rule_fecha_fatal" model="ir.rule"><field name="name">fecha.fatal: empresas activas</field><field name="model_id" ref="model_licitacion_fecha_fatal"/><field name="domain_force">['|', ('procedimiento_id.company_ids', '=', False), ('procedimiento_id.company_ids', 'in', company_ids)]</field></record>
</odoo>
