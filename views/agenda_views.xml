<odoo>
<record id="view_agenda_calendar" model="ir.ui.view"><field name="name">view_agenda_calendar</field><field name="model">licitacion.fecha.fatal</field><field name="arch" type="xml"><calendar class="o_lp_view" string="Agenda de fechas fatales" date_start="fecha" color="tipo" mode="month" create="0" edit="0" delete="0" event_open_popup="true"><field name="name" /><field name="tipo" /><field name="user_id" /></calendar></field></record>
<record id="view_agenda_list" model="ir.ui.view"><field name="name">view_agenda_list</field><field name="model">licitacion.fecha.fatal</field><field name="arch" type="xml"><list class="o_lp_view" create="0" edit="0" delete="0" decoration-danger="fecha &lt; now and state == 'detectado'"><field name="fecha" /><field name="tipo" /><field name="procedimiento_id" /><field name="state" /><field name="user_id" /><button name="action_open_procedimiento" string="Abrir" type="object" /></list></field></record>
<record id="view_agenda_form" model="ir.ui.view"><field name="name">view_agenda_form</field><field name="model">licitacion.fecha.fatal</field><field name="arch" type="xml"><form class="o_lp_view" create="0" edit="0" delete="0"><header><button name="action_open_procedimiento" string="Abrir procedimiento" type="object" /></header><sheet><group><field name="procedimiento_id" /><field name="tipo" /><field name="fecha" /><field name="user_id" /></group></sheet></form></field></record>
<record id="view_agenda_search" model="ir.ui.view"><field name="name">view_agenda_search</field><field name="model">licitacion.fecha.fatal</field><field name="arch" type="xml"><search><field name="procedimiento_id"/><filter name="proximas" string="Próximas 72 h" domain="[('fecha','&gt;=',datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')),('fecha','&lt;=',(datetime.datetime.now()+relativedelta(hours=72)).strftime('%Y-%m-%d %H:%M:%S')),('state','not in',['descartado','no_viable','con_fallo'])]"/><filter name="vencidas" string="Vencidas sin actuar" domain="[('fecha','&lt;',datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')),('state','=','detectado')]"/><filter name="juntas" string="Juntas" domain="[('tipo','=','junta')]"/><filter name="preguntas" string="Preguntas" domain="[('tipo','=','preguntas')]"/><group><filter name="tipo" string="Tipo de evento" context="{'group_by':'tipo'}"/><filter name="responsable" string="Responsable" context="{'group_by':'user_id'}"/></group></search></field></record>
<record id="action_agenda" model="ir.actions.act_window"><field name="name">Agenda</field><field name="res_model">licitacion.fecha.fatal</field><field name="view_mode">calendar,list,form</field></record>

</odoo>