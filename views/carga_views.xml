<odoo>
<record id="view_carga_list" model="ir.ui.view"><field name="name">view_carga_list</field><field name="model">licitacion.carga</field><field name="arch" type="xml"><list create="0" decoration-warning="state == 'pendiente_asignacion'"><field name="fecha_snapshot" /><field name="archivo_nombre" /><field name="tipo_detectado" /><field name="alcance" /><field name="registros" /><field name="state" /><field name="resumen" /><field name="user_id" /></list></field></record>
<record id="view_carga_form" model="ir.ui.view"><field name="name">view_carga_form</field><field name="model">licitacion.carga</field><field name="arch" type="xml"><form create="0" edit="0"><header><button name="action_asignar" string="Asignar procedimiento" type="object" invisible="state != 'pendiente_asignacion'"/><button name="action_preview" string="Previsualizar cambios" type="object" invisible="state not in ('borrador','previsualizada')"/><button name="action_rechazar" string="Rechazar carga" type="object" invisible="state in ('confirmada','rechazada')"/><field name="state" widget="statusbar"/></header><sheet><group><field name="archivo_nombre" /><field name="fecha_snapshot" /><field name="tipo_detectado" /><field name="procedimiento_id" /><field name="origen_portal" /><field name="alcance" /><field name="zona_horaria" /><field name="resumen" /><field name="nota_asignacion" /><field name="user_id" /><field name="company_ids" widget="many2many_tags"/><field name="archivo" filename="archivo_nombre"/></group></sheet><chatter/></form></field></record>
<record id="action_cargas" model="ir.actions.act_window"><field name="name">Historial de cargas</field><field name="res_model">licitacion.carga</field><field name="view_mode">list,form</field></record>

</odoo>