<odoo>
<record id="view_carga_list" model="ir.ui.view"><field name="name">view_carga_list</field><field name="model">licitacion.carga</field><field name="arch" type="xml"><list create="0" decoration-warning="state == 'pendiente_asignacion'"><field name="fecha_snapshot" /><field name="archivo_nombre" /><field name="tipo_detectado" /><field name="subtipo_detectado" /><field name="tipo_archivo_id" /><field name="alcance" /><field name="registros" /><field name="state" /><field name="resumen" /><field name="user_id" /><field name="binary_sha256" optional="hide"/><field name="reimportacion_forzada" optional="hide"/><field name="procesado_el" optional="hide"/></list></field></record>
<record id="view_carga_form" model="ir.ui.view"><field name="name">view_carga_form</field><field name="model">licitacion.carga</field><field name="arch" type="xml"><form create="0" edit="0"><header><button name="action_asignar" string="Asignar procedimiento" type="object" invisible="state != 'pendiente_asignacion'"/><button name="action_preview" string="Previsualizar cambios" type="object" invisible="state not in ('borrador','previsualizada')"/><button name="action_rechazar" string="Rechazar carga" type="object" invisible="state in ('confirmada','rechazada')"/><field name="state" widget="statusbar"/></header><sheet><field name="detalle_borrador" invisible="1"/><div class="alert alert-warning" role="alert" invisible="not detalle_borrador">BORRADOR - Pendiente validación cliente. Revise las cantidades y las incidencias SAI antes de continuar.</div><div class="alert alert-info" role="status" invisible="coincidencias_count &lt; 2">
Este binario tiene <field name="coincidencias_count" nolabel="1"/> cargas confirmadas. Se conserva el historial para auditoría.
<field name="coincidencias_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="archivo_nombre"/><field name="fecha_snapshot"/><field name="procesado_el"/><field name="procesado_por_id"/><field name="resumen"/><field name="reimportacion_forzada"/><button name="action_open" string="Abrir" type="object"/></list></field></div><group><field name="archivo_nombre" /><field name="fecha_snapshot" /><field name="tipo_detectado" /><field name="subtipo_detectado" /><field name="tipo_archivo_id" /><field name="procedimiento_id" /><field name="origen_portal" /><field name="alcance" /><field name="zona_horaria" /><field name="resumen" /><field name="nota_asignacion" /><field name="user_id" /><field name="procesado_el" /><field name="procesado_por_id" /><field name="carga_base_id" /><field name="binary_sha256" /><field name="company_ids" widget="many2many_tags"/><field name="archivo" filename="archivo_nombre"/></group><group string="Reimportación" invisible="not reimportacion_forzada"><field name="reimportacion_forzada" /><field name="motivo_reimportacion" /><field name="cargas_origen_ids" widget="many2many_tags"/></group><div class="alert alert-info" invisible="not aviso_base"><field name="aviso_base" nolabel="1"/></div></sheet><chatter/></form></field></record>
<record id="action_cargas" model="ir.actions.act_window"><field name="name">Historial de cargas</field><field name="res_model">licitacion.carga</field><field name="view_mode">list,form</field></record>

</odoo>