<odoo>
<record id="view_incidencia_list" model="ir.ui.view"><field name="name">view_incidencia_list</field><field name="model">licitacion.incidencia</field><field name="arch" type="xml"><list create="0" decoration-danger="severidad == 'bloqueante' and state == 'abierta'"><field name="procedimiento_id" /><field name="identificador_observado" /><field name="origen" /><field name="campo" /><field name="valor_esperado" /><field name="valor_encontrado" /><field name="severidad" /><field name="state" /><field name="create_date" /></list></field></record>
<record id="view_incidencia_form" model="ir.ui.view"><field name="name">view_incidencia_form</field><field name="model">licitacion.incidencia</field><field name="arch" type="xml"><form create="0" edit="0"><header><button name="action_resolver" string="Resolver" type="object" invisible="state != 'abierta'" class="btn-primary"/><button name="action_ignorar" string="Ignorar" type="object" invisible="state != 'abierta'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="procedimiento_id" /><field name="identificador_observado" /><field name="partida_id" /><field name="carga_id" /><field name="origen" /><field name="campo" /><field name="severidad" /></group><group><group string="Valor actual"><field name="valor_esperado" nolabel="1"/></group><group string="Valor encontrado"><field name="valor_encontrado" nolabel="1"/></group></group><group><field name="nota_resolucion" /><field name="resuelta_por_id" /><field name="fecha_resolucion" /><field name="escalada_fecha" /></group></sheet><chatter/></form></field></record>
<record id="view_incidencia_search" model="ir.ui.view"><field name="name">view_incidencia_search</field><field name="model">licitacion.incidencia</field><field name="arch" type="xml"><search><field name="procedimiento_id"/><field name="campo"/><filter name="abiertas" string="Abiertas" domain="[('state','=','abierta')]"/><filter name="bloqueantes" string="Bloqueantes" domain="[('severidad','=','bloqueante')]"/><group><filter name="por_origen" string="Origen" context="{'group_by':'origen'}"/><filter name="por_procedimiento" string="Procedimiento" context="{'group_by':'procedimiento_id'}"/></group></search></field></record>
<record id="action_incidencias" model="ir.actions.act_window"><field name="name">Incidencias</field><field name="res_model">licitacion.incidencia</field><field name="view_mode">list,form</field><field name="context">{'search_default_abiertas':1}</field></record>

</odoo>