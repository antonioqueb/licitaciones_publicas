<odoo>
    <!-- Centro de Licitaciones: una sola acción de cliente (static/src/js/lp/hub.js) con un espacio por contexto. -->
    <record id="action_lp_inicio" model="ir.actions.client">
        <field name="name">Centro de Licitaciones</field>
        <field name="tag">licitaciones_publicas.hub</field>
        <field name="context">{'lp_view': 'inicio'}</field>
    </record>
    <record id="action_lp_procedimientos" model="ir.actions.client">
        <field name="name">Procedimientos</field>
        <field name="tag">licitaciones_publicas.hub</field>
        <field name="context">{'lp_view': 'procedimientos'}</field>
    </record>
    <record id="action_lp_expedientes" model="ir.actions.client">
        <field name="name">Expedientes</field>
        <field name="tag">licitaciones_publicas.hub</field>
        <field name="context">{'lp_view': 'expedientes'}</field>
    </record>
    <record id="action_lp_carga" model="ir.actions.client">
        <field name="name">Nueva carga</field>
        <field name="tag">licitaciones_publicas.hub</field>
        <field name="context">{'lp_view': 'carga'}</field>
    </record>
    <!-- Abiertas desde el botón «Vista guiada» de los formularios: reciben active_model y active_id. -->
    <record id="action_lp_procedimiento" model="ir.actions.client">
        <field name="name">Procedimiento</field>
        <field name="tag">licitaciones_publicas.hub</field>
        <field name="context">{'lp_view': 'procedimiento'}</field>
    </record>
    <record id="action_lp_expediente" model="ir.actions.client">
        <field name="name">Expediente</field>
        <field name="tag">licitaciones_publicas.hub</field>
        <field name="context">{'lp_view': 'expediente'}</field>
    </record>
</odoo>
